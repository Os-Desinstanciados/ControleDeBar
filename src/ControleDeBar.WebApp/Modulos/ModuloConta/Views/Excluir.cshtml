@model DetalhesContaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Conta";
}

<div class="row justify-content-center">
    <div class="col-lg-6">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-3">Excluir Conta</h2>

                <div class="alert alert-danger">
                    Tem certeza que deseja excluir esta conta?
                </div>

                <div class="mb-3">
                    <strong>Mesa:</strong>
                    @Model.Mesa.Numero
                </div>

                <div class="mb-3">
                    <strong>Garçom:</strong>
                    @Model.Garcom.Nome
                </div>

                <div class="mb-3">
                    <strong>Abertura:</strong>
                    @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div class="mb-4">
                    <strong>Fechamento:</strong>
                    @Model.DataFechamento?.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div class="d-flex justify-content-between">

                    <a class="btn btn-outline-secondary"
                       asp-action="Detalhes"
                       asp-route-id="@Model.Id">
                        Cancelar
                    </a>

                    <form asp-action="ExcluirConfirmado"
                          asp-route-id="@Model.Id"
                          method="post">

                        <button type="submit"
                                class="btn btn-danger">
                            Confirmar Exclusão
                        </button>

                    </form>

                </div>

            </div>
        </div>

    </div>
</div>