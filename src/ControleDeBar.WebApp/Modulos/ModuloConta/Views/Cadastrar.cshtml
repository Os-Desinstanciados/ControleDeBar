@model CadastrarContaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Abrir Conta";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-1">Abrir Conta</h2>

                <p class="text-secondary mb-4">
                    Selecione a mesa e o garçom responsável.
                </p>

                <form asp-action="Cadastrar" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="MesaId" class="form-label">Mesa</label>

                        <select asp-for="MesaId"
                                class="form-select">

                            <option value="">
                                Selecione uma mesa
                            </option>

                            @foreach (var mesa in Model.Mesas)
                            {
                                <option value="@mesa.Id">
                                    Mesa @mesa.Numero
                                </option>
                            }

                        </select>

                        <span asp-validation-for="MesaId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="GarcomId" class="form-label">
                            Garçom
                        </label>

                        <select asp-for="GarcomId"
                                class="form-select">

                            <option value="">
                                Selecione um garçom
                            </option>

                            @foreach (var garcom in Model.Garcons)
                            {
                                <option value="@garcom.Id">
                                    @garcom.Nome
                                </option>
                            }

                        </select>

                        <span asp-validation-for="GarcomId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a class="btn btn-outline-secondary"
                           asp-action="Listar">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Abrir Conta
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>
