@if (Model.Status == StatusConta.Aberta)
{
    <hr />

    <h4>Adicionar Pedido</h4>

    <form asp-controller="Pedido" asp-action="Adicionar" method="post">
        
        <input type="hidden" name="contaId" value="@Model.Id" />

        <div class="row">
            <div class="col-md-6">
                <label class="form-label">Produto</label>

                <select name="ProdutoId" class="form-select">
                    <option value="">Selecione um produto</option>

                    @foreach (var produto in Model.Produtos!)
                    {
                        <option value="@produto.Id">
                            @produto.Nome - @produto.Preco.ToString("C2")
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Quantidade</label>

                <input
                    type="number"
                    name="Quantidade"
                    class="form-control"
                    min="1"
                    value="1" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">
                    Adicionar
                </button>
            </div>
        </div>
    </form>
}