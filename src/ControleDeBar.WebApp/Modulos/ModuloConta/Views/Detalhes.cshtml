@using ControleDeBar.Dominio.Modulos.ModuloConta
@model DetalhesContaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Detalhes da Conta";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h2 class="mb-0">
                        Conta - Mesa @Model.Mesa.Numero
                    </h2>

                    @if (Model.Status == StatusConta.Aberta)
                    {
                        <span class="badge text-bg-success">
                            Aberta
                        </span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">
                            Fechada
                        </span>
                    }

                </div>

                <hr />

                <div class="row g-3 mt-1">

                    <div class="col-md-6">
                        <strong>Mesa</strong>
                        <p class="text-secondary">
                            @Model.Mesa.Numero
                        </p>
                    </div>

                    <div class="col-md-6">
                        <strong>Garçom</strong>
                        <p class="text-secondary">
                            @Model.Garcom.Nome
                        </p>
                    </div>

                    <div class="col-md-6">
                        <strong>Data de Abertura</strong>
                        <p class="text-secondary">
                            @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>

                    <div class="col-md-6">
                        <strong>Data de Fechamento</strong>

                        @if (Model.DataFechamento.HasValue)
                        {
                            <p class="text-secondary">
                                @Model.DataFechamento.Value.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        }
                        else
                        {
                            <p class="text-secondary">
                                -
                            </p>
                        }
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">

                    <a class="btn btn-outline-secondary" asp-action="Listar">
                        Voltar
                    </a>

                    @if (Model.Status == StatusConta.Aberta)
                    {
                        <form asp-action="Fechar" asp-route-id="@Model.Id" method="post">

                            <button type="submit" class="btn btn-outline-danger">
                                Fechar Conta
                            </button>

                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-danger" asp-action="Excluir" asp-route-id="@Model.Id">
                            Excluir
                        </a>
                    }

                </div>

            </div>
        </div>

    </div>
</div>