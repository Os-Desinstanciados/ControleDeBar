@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Mesa";
}

@model ExcluirMesaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Deseja realmente excluir esta mesa?
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">ID</dt>
        <dd class="col-sm-8 text-break">@Model.Id</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Número</dt>
        <dd class="col-sm-8">@Model.Numero</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Número de Lugares</dt>
        <dd class="col-sm-8">@Model.NumeroLugares</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Status da Mesa</dt>
        <dd class="col-sm-8">@Model.StatusMesa</dd>
    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>