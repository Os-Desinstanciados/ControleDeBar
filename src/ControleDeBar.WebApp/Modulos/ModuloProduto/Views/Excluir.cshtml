@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Produto";
}

@model ExcluirProdutoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      method="post">

    <input asp-for="Id" type="hidden">

    <div class="alert alert-primary border-start border-primary border-4 rounded-3">
        Tem certeza que deseja excluir este produto?
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-uppercase small">
            Nome
        </label>

        <input value="@Model.Nome" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-uppercase small">
            Preço
        </label>

        <input value="@Model.Preco.ToString("C")" class="form-control" disabled>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Excluir</button>
    </div>
</form>