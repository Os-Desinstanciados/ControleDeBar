@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
}

<div class="mb-4">
    <h1 class="display-5 fw-semibold mb-2">Controle de Bar</h1>

    <p class="lead text-secondary">
        Gerencie seus clientes, garçons, mesas, produtos e contas conosco.
    </p>
</div>

<h2 class="h5 text-primary mb-3">Módulos disponíveis</h2>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">

    <div class="text-center"">
        <div class="card h-100 border-primary-subtle shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Clientes</h5>
                <p class="card-text text-secondary">
                    Gerencie os clientes cadastrados no sistema.
                </p>

                <a class="btn btn-primary rounded-pill px-4"
                   asp-controller="Cliente"
                   asp-action="Listar">
                    Abrir
                </a>
            </div>
        </div>
    </div>

    <div class="text-center"">
        <div class="card h-100 border-primary-subtle shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Garçons</h5>
                <p class="card-text text-secondary">
                    Gerencie os garçons cadastrados no sistema.
                </p>

                <a class="btn btn-primary rounded-pill px-4"
                   asp-controller="Garcom"
                   asp-action="Listar">
                    Abrir
                </a>
            </div>
        </div>
    </div>

    <div class="text-center"">
        <div class="card h-100 border-primary-subtle shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Mesas</h5>
                <p class="card-text text-secondary">
                    Gerencie as mesas disponíveis no bar.
                </p>

                <a class="btn btn-primary rounded-pill px-4"
                   asp-controller="Mesa"
                   asp-action="Listar">
                    Abrir
                </a>
            </div>
        </div>
    </div>

    <div class="text-center"">
        <div class="card h-100 border-primary-subtle shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Produtos</h5>
                <p class="card-text text-secondary">
                    Gerencie os produtos e seus preços.
                </p>

                <a class="btn btn-primary rounded-pill px-4"
                   asp-controller="Produto"
                   asp-action="Listar">
                    Abrir
                </a>
            </div>
        </div>
    </div>

    <div class="text-center"">
        <div class="card h-100 border-primary-subtle shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Contas</h5>
                <p class="card-text text-secondary">
                    Gerencie as contas abertas no bar.
                </p>

                <a class="btn btn-primary rounded-pill px-4"
                   asp-controller="Conta"
                   asp-action="Listar">
                    Abrir
                </a>
            </div>
        </div>
    </div>

</div>